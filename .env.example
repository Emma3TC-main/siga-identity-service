# Reference only. Initialize-Local.ps1 generates .local/<instance>/.env and RSA keys.
# DB/RabbitMQ credentials come from infrastructure compose/.env.<instance> in team mode.
DB_PASSWORD=generate-a-random-password
RABBITMQ_PASSWORD=generate-another-random-password
MFA_ENCRYPTION_KEY=base64-32-random-bytes
IAM_BOOTSTRAP_PASSWORD=choose-at-least-12-characters
